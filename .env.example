# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Postgres (Neon, Supabase, or any Postgres 13+) ---
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Cloudflare R2 (audio storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marginalia-audio

# --- Accounts ---
# Set to false after you've created your own account to stop anyone else registering.
ALLOW_SIGNUPS=true

# --- Optional: point at mirrors of the Bible APIs ---
# GETBIBLE_BASE=https://api.getbible.net/v2
# BOLLS_BASE=https://bolls.life
